# ============================================================
# Hueney Ruca — variables de entorno
# Copiá este archivo a .env y completá los valores.
# Variables con prefijo NEXT_PUBLIC_ se exponen al navegador.
# ============================================================

# ---------- Supabase ----------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Anon key: única key pública usada por el cliente (navegador y API routes)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SOLO para scripts de setup (scripts/setup.mjs). Nunca la expongas con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Supabase CLI (para npm run db:link / db:migrate) ----------
# https://supabase.com/docs/guides/cli/local-development?queryMethod=cli#authentication
SUPABASE_ACCESS_TOKEN=
# Ref del proyecto (parte del dominio: https://<REF>.supabase.co)
SUPABASE_PROJECT_REF=
# Password de la base de datos (Dashboard > Settings > Database). Alternativa: SUPABASE_DB_URL=postgresql://...
SUPABASE_DB_PASSWORD=

# ---------- Bootstrap del admin (scripts/setup.mjs) ----------
# Si están definidos, setup crea/actualiza este usuario y le asigna role=3 (superadmin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Stripe ----------
# Dashboard > Developers > API keys (test mode)
STRIPE_SECRET_KEY=
# Publishable key (navegador)
NEXT_PUBLIC_STRIPE_KEY=

# ---------- EmailJS (formularios de contacto) ----------
# https://dashboard.emailjs.com/
NEXT_PUBLIC_EMAIL_PUBLIC_KEY=
NEXT_PUBLIC_EMAIL_TEMPLATE_GENERIC=
NEXT_PUBLIC_EMAIL_TEMPLATE_CONTACT=
NEXT_PUBLIC_EMAIL_SERVICE_ID=
